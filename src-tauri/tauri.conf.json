{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Utils",
  "version": "0.1.0",
  "identifier": "com.pabloulloa.pdfutils",
  "build": {
    "beforeDevCommand": "vp run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "vp run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDF Utils",
        "decorations": false,
        "width": 1280,
        "height": 850,
        "minWidth": 580,
        "minHeight": 500
      }
    ],
    "security": {
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'",
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0MDI3MUUwRTA2MzRFNwpSV1RuTkFZT0hpZEFCampKQzRabzYxbzJvQ3liaHVsK3REMEF4VU5BZitOcU43a0FkcGJKWnRYVgo=",
      "endpoints": ["https://github.com/UlloaSP/pdf/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "externalBin": ["binaries/pdf-worker"],
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "wix": { "language": "es-ES" }
    }
  }
}
