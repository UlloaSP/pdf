      "default": "Pixelar",
      "options": [
        "Pixelar",
        "Difuminar"
      ]
    },
    {
      "key": "strength",
      "label": "Bloque de píxeles o radio de desenfoque (2–100)",
      "type": "number",
      "default": 16
    }
  ],
  "requirements": []
}
