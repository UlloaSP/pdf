{
  "id": "image_pixelate",
  "workspace": "images",
  "name": "Pixelar o difuminar",
  "description": "Oculta regiones elegidas por coordenadas. No detecta caras u objetos automáticamente.",
  "category": "Edición",
  "extensions": [
    "jpg",
    "jpeg",
    "png",
    "webp",
    "bmp",
    "tif",
    "tiff",
    "gif"
