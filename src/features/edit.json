{
  "id": "edit",
  "name": "Añadir texto",
  "description": "Superpone texto sin modificar ni eliminar el texto original.",
  "category": "Edición",
  "extensions": [
    "pdf"
  ],
  "multiple": false,
  "fields": [
    {
      "key": "pages",
      "label": "Páginas (vacío = todas; ejemplo 1,3-5)",
      "type": "text",
      "default": ""
    },
    {
      "key": "text",
      "label": "Texto",
      "type": "textarea",
      "default": "Texto añadido"
    },
    {
      "key": "x",
      "label": "Desde izquierda (pt)",
      "type": "number",
      "default": 36
    },
    {
      "key": "y",
      "label": "Desde abajo (pt)",
      "type": "number",
      "default": 36
    },
    {
      "key": "font_size",
      "label": "Tamaño (pt)",
      "type": "number",
      "default": 14
    }
  ],
  "requirements": []
}
