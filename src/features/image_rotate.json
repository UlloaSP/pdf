  "category": "Edición",
  "extensions": [
    "jpg",
    "jpeg",
    "png",
    "gif"
  ],
  "multiple": true,
  "fields": [
    {
      "key": "angle",
      "label": "Giro horario",
      "type": "select",
      "default": "90",
      "options": [
        "90",
        "180",
        "270"
      ]
    },
    {
      "key": "orientation",
      "label": "Aplicar a",
      "type": "select",
      "default": "Todas",
      "options": [
        "Todas",
        "Horizontales",
        "Verticales"
      ]
    }
  ],
  "requirements": []
}
